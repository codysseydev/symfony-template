{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "{{PRODUCT_SLUG}}/{{PRODUCT_SLUG}}",
    "type": "project",
    "description": "{{PRODUCT_PITCH}}",
    "license": "proprietary",
    "require": {
        "php": ">=8.5",
        "doctrine/doctrine-bundle": "^3.0",
        "doctrine/doctrine-migrations-bundle": "^4.0",
        "doctrine/orm": "^3.5",
        "symfony/console": "8.1.*",
        "symfony/doctrine-messenger": "8.1.*",
        "symfony/dotenv": "8.1.*",
        "symfony/framework-bundle": "8.1.*",
        "symfony/messenger": "8.1.*",
        "symfony/redis-messenger": "8.1.*",
        "symfony/runtime": "8.1.*",
        "symfony/scheduler": "8.1.*",
        "symfony/yaml": "8.1.*"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.90",
        "phparkitect/phparkitect": "^1.1",
        "phpstan/phpstan": "^2.1",
        "phpstan/phpstan-doctrine": "^2.0",
        "phpstan/phpstan-symfony": "^2.0",
        "phpunit/phpunit": "^12.0",
        "rector/rector": "^2.0",
        "symfony/browser-kit": "8.1.*",
        "symfony/css-selector": "8.1.*"
    },
    "autoload": {
        "psr-4": {
            "Framework\\": "Framework/",
            "{{PRODUCT_NAMESPACE}}\\": "{{PRODUCT_NAMESPACE}}/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/",
            "Tools\\PHPStan\\": "tools/phpstan/"
        }
    },
    "scripts": {
        "cs": [
            "php-cs-fixer fix --dry-run --diff --config=.php-cs-fixer.dist.php"
        ],
        "arkitect": [
            "phparkitect check"
        ],
        "phpstan": [
            "@php bin/console cache:warmup --env=dev",
            "phpstan analyse --memory-limit=2G"
        ],
        "rector": [
            "rector process --dry-run --no-progress-bar"
        ],
        "test": [
            "@putenv COMPOSER_PROCESS_TIMEOUT=0",
            "phpunit"
        ],
        "gates": [
            "@cs",
            "@arkitect",
            "@phpstan",
            "@rector",
            "@test"
        ]
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "symfony/runtime": true
        }
    },
    "extra": {
        "symfony": {
            "allow-contrib": false,
            "require": "8.1.*"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
