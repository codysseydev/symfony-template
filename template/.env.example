APP_NAME="{{PRODUCT_NAME}}"
APP_ENV=dev
APP_DEBUG=1
# APP_SECRET is generated by the env step of .factory/recipe.yml.
# Never commit a real one.

# The Docker stack runs MySQL as the root user.
DATABASE_URL="mysql://root:root@mysql:3306/{{PRODUCT_SLUG}}?serverVersion=8.4&charset=utf8mb4"

# Async transport (messenger:consume async in the queue container).
MESSENGER_TRANSPORT_DSN=redis://redis:6379/messages
